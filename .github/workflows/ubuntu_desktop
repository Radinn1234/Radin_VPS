```yaml
name: Ubuntu Runner + Tailscale + SSH + KDE Plasma + RDP

on:
  workflow_dispatch:

jobs:
  terminal:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:

      # ==========================================
      # SYSTEM INFO
      # ==========================================
      - name: Show Ubuntu Information
        run: |
          set -e

          echo "=== Operating System ==="
          cat /etc/os-release

          echo ""
          echo "=== Kernel ==="
          uname -a

          echo ""
          echo "=== CPU ==="
          nproc

          echo ""
          echo "=== RAM ==="
          free -h

      # ==========================================
      # TAILSCALE
      # ==========================================
      - name: Install Tailscale
        run: |
          set -e

          echo "=== Installing Tailscale ==="

          curl -fsSL https://tailscale.com/install.sh | sh

          sudo systemctl enable --now tailscaled

          echo "Tailscale installed."

      # ==========================================
      # CONNECT RUNNER TO TAILSCALE
      # ==========================================
      - name: Connect Runner to Tailscale
        env:
          TS_AUTHKEY: ${{ secrets.TS_AUTHKEY }}
        run: |
          set -e

          echo "=== Connecting Runner to Tailscale ==="

          if [ -z "$TS_AUTHKEY" ]; then
            echo "ERROR: TS_AUTHKEY secret is empty."
            exit 1
          fi

          sudo tailscale up \
            --auth-key="$TS_AUTHKEY" \
            --hostname="github-runner-${GITHUB_RUN_ID}"

          echo ""
          echo "=== Tailscale Status ==="
          sudo tailscale status

          echo ""
          echo "=== Tailscale IPv4 ==="
          sudo tailscale ip -4

      # ==========================================
      # KDE PLASMA + XRDP
      # ==========================================
      - name: Install KDE Plasma + RDP
        run: |
          set -e

          echo "=== Updating Ubuntu ==="

          sudo apt-get update

          echo ""
          echo "=== Installing KDE Plasma ==="

          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
            kde-plasma-desktop \
            xrdp \
            dbus-x11 \
            xorgxrdp

          echo ""
          echo "=== KDE + XRDP installed ==="

      # ==========================================
      # CONFIGURE KDE FOR XRDP
      # ==========================================
      - name: Configure KDE Plasma for XRDP
        run: |
          set -e

          echo "=== Configuring XRDP session ==="

          sudo cp /etc/xrdp/startwm.sh /etc/xrdp/startwm.sh.backup

          sudo tee /etc/xrdp/startwm.sh > /dev/null <<'EOF'
          #!/bin/sh

          export LANG=C.UTF-8
          export LANGUAGE=C.UTF-8
          export LC_ALL=C.UTF-8

          export XDG_CURRENT_DESKTOP=KDE
          export XDG_SESSION_DESKTOP=KDE
          export KDE_FULL_SESSION=true

          unset DBUS_SESSION_BUS_ADDRESS
          unset XDG_RUNTIME_DIR

          exec dbus-run-session startplasma-x11
          EOF

          sudo chmod +x /etc/xrdp/startwm.sh

          echo "XRDP KDE session configured."

      # ==========================================
      # ENABLE XRDP
      # ==========================================
      - name: Enable RDP
        run: |
          set -e

          echo "=== Enabling XRDP ==="

          sudo adduser xrdp ssl-cert || true

          sudo systemctl enable xrdp
          sudo systemctl restart xrdp

          echo ""
          echo "=== XRDP Status ==="

          sudo systemctl status xrdp --no-pager || true

          echo ""
          echo "=== RDP Listening Port ==="

          sudo ss -tlnp | grep ':3389' || true

      # ==========================================
      # SSH SERVER
      # ==========================================
      - name: Configure SSH
        env:
          SSH_PUBLIC_KEY: ${{ secrets.SSH_PUBLIC_KEY }}
        run: |
          set -e

          echo "=== Installing OpenSSH Server ==="

          sudo apt-get update
          sudo apt-get install -y openssh-server

          echo "=== Preparing SSH ==="

          sudo mkdir -p /home/runner/.ssh

          echo "$SSH_PUBLIC_KEY" | sudo tee \
            /home/runner/.ssh/authorized_keys > /dev/null

          sudo chmod 700 /home/runner/.ssh
          sudo chmod 600 /home/runner/.ssh/authorized_keys

          sudo chown -R runner:runner /home/runner/.ssh

          echo "=== Configuring SSH ==="

          sudo mkdir -p /run/sshd

          sudo sed -i \
            's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' \
            /etc/ssh/sshd_config

          sudo sed -i \
            's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' \
            /etc/ssh/sshd_config

          sudo sed -i \
            's/^#\?PermitRootLogin.*/PermitRootLogin yes/' \
            /etc/ssh/sshd_config

          sudo systemctl enable ssh
          sudo systemctl restart ssh

          echo "SSH server started."

      # ==========================================
      # SET ROOT PASSWORD
      # ==========================================
      - name: Set root password
        env:
          ROOT_PASSWORD: ${{ secrets.ROOT_PASSWORD }}
        run: |
          set -e

          if [ -z "$ROOT_PASSWORD" ]; then
            echo "ERROR: ROOT_PASSWORD secret is empty."
            exit 1
          fi

          echo "root:$ROOT_PASSWORD" | sudo chpasswd

          echo "Root password has been set."

      # ==========================================
      # VERIFY SSH
      # ==========================================
      - name: Verify SSH
        run: |
          set -e

          echo "=== SSH Status ==="
          sudo systemctl status ssh --no-pager || true

          echo ""
          echo "=== SSH Listening ==="
          sudo ss -tlnp | grep ':22' || true

          echo ""
          echo "=== SSH Public Key ==="
          sudo test -s /home/runner/.ssh/authorized_keys

      # ==========================================
      # VERIFY KDE
      # ==========================================
      - name: Verify KDE Plasma
        run: |
          set -e

          echo "=== KDE Plasma ==="

          if command -v plasmashell >/dev/null 2>&1; then
            plasmashell --version || true
          else
            echo "plasmashell not found"
          fi

          echo ""
          echo "=== XRDP ==="

          sudo systemctl is-enabled xrdp || true
          sudo systemctl is-active xrdp || true

          echo ""
          echo "=== RDP Port ==="

          sudo ss -tlnp | grep ':3389' || true

      # ==========================================
      # DOCKER / DEBIAN 11
      # ==========================================
      - name: Start Debian 11 Container
        run: |
          set -e

          echo "=== Pulling Debian 11 Bullseye ==="

          docker pull debian:bullseye

          echo "=== Starting Debian 11 ==="

          docker rm -f debian11 2>/dev/null || true

          docker run -d \
            --name debian11 \
            --hostname debian11 \
            debian:bullseye \
            tail -f /dev/null

          echo ""
          echo "=== Debian OS ==="

          docker exec debian11 cat /etc/os-release

      # ==========================================
      # CONNECTION INFORMATION
      # ==========================================
      - name: Show Connection Information
        run: |
          echo ""
          echo "=========================================="
          echo "       GITHUB RUNNER READY"
          echo "=========================================="

          IP=$(sudo tailscale ip -4)

          echo ""
          echo "Tailscale IP:"
          echo "$IP"

          echo ""
          echo "SSH:"
          echo "ssh runner@$IP"

          echo ""
          echo "RDP:"
          echo "$IP:3389"

          echo ""
          echo "RDP Username:"
          echo "runner"

          echo ""
          echo "Desktop:"
          echo "KDE Plasma"

          echo ""
          echo "Docker Debian 11:"
          echo "docker exec -it debian11 bash"

          echo ""
          echo "=========================================="

      # ==========================================
      # KEEP ALIVE
      # ==========================================
      - name: Keep Runner Alive
        run: |
          echo ""
          echo "=========================================="
          echo " Runner will remain online for 6 hours"
          echo "=========================================="
          echo ""

          while true; do
            echo "[$(date)] Runner alive"
            sleep 300
          done
```
